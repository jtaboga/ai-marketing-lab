# --- Secrets: never commit these ---
.env
.env.*
*.key
*.pem
secrets.*
credentials.*

# --- OS clutter ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editor / IDE ---
.vscode/
.idea/
*.swp

# --- Python (in case you add scripts) ---
__pycache__/
*.pyc
venv/
.venv/

# --- Node (in case you add anything JS) ---
node_modules/
